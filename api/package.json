{
  "name": "api-contract-tests",
  "version": "1.0.0",
  "description": "API Contract Tests for Smart To-Do List",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit",
    "format": "prettier --write 'tests/**/*.ts'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "contract",
    "playwright",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
